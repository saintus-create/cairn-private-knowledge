# =============================================================================
# Cairn Production Environment
# AI Configuration
# =============================================================================

# -----------------------------------------------------------------------------
# Required Settings
# -----------------------------------------------------------------------------

# Single-owner mode for production (set to false for OAuth)
CAIRN_SINGLE_OWNER_MODE=false

# Owner credentials (required for single-owner mode)
CAIRN_OWNER_OPEN_ID=cairn-admin
OWNER_OPEN_ID=cairn-admin

# JWT Secret (generate with: openssl rand -base64 32)
JWT_SECRET=change-this-to-a-strong-secret-in-production

# Database connection (MySQL)
DATABASE_URL=mysql://user:password@localhost:3306/cairn

# OAuth Server URL
OAUTH_SERVER_URL=https://your-oauth-server.com

# Application IDs
VITE_APP_ID=cairn-production
VITE_OAUTH_PORTAL_URL=https://your-oauth-server.com

# -----------------------------------------------------------------------------
# AI Provider Configuration
# -----------------------------------------------------------------------------

# Choose ONE primary AI provider for production:
# Options: openrouter, mistral, codestral, groq, huggingface, custom
CAIRN_AI_PROVIDER=huggingface

# Provider-specific API keys (only the active one is required)
# For Hugging Face:
HUGGINGFACE_API_KEY=hf_your_token_here

# For Mistral:
# MISTRAL_API_KEY=your_mistral_token

# For Codestral:
# CODESTRAL_API_KEY=your_codestral_token

# For Groq:
# GROQ_API_KEY=your_groq_token

# For OpenRouter:
# CAIRN_AI_API_KEY=your_openrouter_key

# Base URL (only for custom/huggingface, others have defaults)
CAIRN_AI_BASE_URL=https://api-inference.huggingface.co

# Model selection - change to your preferred model
# Default: laurabernardy/LuxGPT-basedEN
CAIRN_AI_MODEL=laurabernardy/LuxGPT-basedEN

# Optional: Your app URL for OpenRouter analytics
CAIRN_AI_APP_URL=https://your-cairn-app.com
CAIRN_AI_APP_NAME=Cairn

# -----------------------------------------------------------------------------
# Regional Model Presets
# -----------------------------------------------------------------------------
# Uncomment a preset to use regional models:

# Singapore (ASEAN languages)
# CAIRN_AI_MODEL=aisingapore/sea-lion-7b

# European Union (Multilingual)
# CAIRN_AI_MODEL=openeurollm/eurollm-7b

# Taiwan (Traditional Chinese)
# CAIRN_AI_MODEL=yentinglin/taiwan-llm-7b

# Slovenia (Slovene)
# CAIRN_AI_MODEL=cjvt/GaMS3-12B-Instruct

# Czech
# CAIRN_AI_MODEL=Utkarsh/beryl-i7b-mistral

# -----------------------------------------------------------------------------
# Optional Settings
# -----------------------------------------------------------------------------

# Application port (default: 3000)
PORT=3000

# Node environment
NODE_ENV=production

# Log level (debug, info, warn, error)
LOG_LEVEL=info
